:root {
  --glass-bg: rgba(248, 252, 255, 0.76);
  --glass-strong: rgba(255, 255, 255, 0.88);
  --ink: #182333;
  --ink-muted: #617083;
  --accent: #37c6c0;
  --accent-deep: #146b82;
  --line-soft: rgba(76, 117, 145, 0.18);
  --shadow-soft: 0 22px 70px rgba(9, 28, 45, 0.18);
}

body {
  background:
    radial-gradient(circle at 16% 12%, rgba(55, 198, 192, 0.28), transparent 30%),
    linear-gradient(135deg, rgba(9, 20, 34, 0.42), rgba(16, 63, 86, 0.22)),
    url(/images/back.jpg);
  background-repeat: no-repeat;
  background-attachment: fixed;
  background-position: 50% 50%;
  background-size: cover;
  color: var(--ink);
}

body::before {
  background: linear-gradient(180deg, rgba(7, 16, 28, 0.14), rgba(7, 16, 28, 0.34));
  content: "";
  inset: 0;
  pointer-events: none;
  position: fixed;
  z-index: -1;
}

.headband {
  background: linear-gradient(90deg, var(--accent), #9be7ff, var(--accent-deep));
  height: 4px;
}

.header-inner,
.sidebar-inner,
.post-block,
.pagination,
.comments {
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  background: var(--glass-bg);
  border: 1px solid var(--line-soft);
  border-radius: 18px;
  box-shadow: var(--shadow-soft);
}

.header-inner {
  background: var(--glass-strong);
}

.content-wrap {
  background: transparent;
  border: 0;
  box-shadow: none;
}

.site-title {
  font-size: 1.9em;
  letter-spacing: 0.08em;
}

.site-subtitle {
  color: var(--accent-deep);
  font-size: 0.92em;
  letter-spacing: 0.04em;
}

.site-nav,
.menu .menu-item a {
  color: var(--ink);
}

.menu .menu-item a:hover,
.post-title-link:hover,
.post-meta a:hover {
  color: var(--accent-deep);
}

.home-hero {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.86), rgba(222, 249, 250, 0.74)),
    radial-gradient(circle at 92% 18%, rgba(55, 198, 192, 0.32), transparent 34%);
  border: 1px solid rgba(255, 255, 255, 0.72);
  border-radius: 24px;
  box-shadow: var(--shadow-soft);
  margin: 0 0 26px;
  overflow: hidden;
  padding: 42px 46px;
  position: relative;
}

.home-hero::after {
  background: linear-gradient(180deg, rgba(55, 198, 192, 0.75), rgba(20, 107, 130, 0.12));
  content: "";
  height: 120px;
  position: absolute;
  right: 34px;
  top: -34px;
  transform: rotate(28deg);
  width: 10px;
}

.home-hero__eyebrow {
  color: var(--accent-deep);
  font-size: 0.82em;
  font-weight: 700;
  letter-spacing: 0.32em;
  margin: 0 0 12px;
  text-transform: uppercase;
}

.home-hero__title {
  color: var(--ink);
  font-size: clamp(2.2rem, 7vw, 4.8rem);
  letter-spacing: 0.08em;
  line-height: 1;
  margin: 0;
}

.home-hero__subtitle {
  color: var(--ink-muted);
  font-size: 1.05em;
  margin: 18px 0 0;
  max-width: 620px;
}

.post-block {
  margin-bottom: 24px;
  padding: 30px 34px;
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
}

.post-block:hover {
  border-color: rgba(55, 198, 192, 0.42);
  box-shadow: 0 26px 80px rgba(9, 28, 45, 0.24);
  transform: translateY(-3px);
}

.post-title {
  font-weight: 800;
}

.post-title-link {
  color: var(--ink);
  letter-spacing: 0.03em;
}

.post-meta {
  color: var(--ink-muted);
}

.post-body {
  color: #243142;
  line-height: 1.9;
}

.post-body,
.post-body p,
.post-body li,
.post-meta,
.post-meta span {
  color: #243142;
}

.post-excerpt {
  color: var(--ink-muted);
  display: -webkit-box;
  line-height: 1.85;
  margin: 12px 0 22px;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.post-body img {
  border-radius: 14px;
  box-shadow: 0 16px 46px rgba(8, 28, 44, 0.22);
}

.post-button .btn {
  background: linear-gradient(135deg, var(--accent-deep), var(--accent));
  border: 0;
  border-radius: 999px;
  color: #fff;
  padding: 8px 18px;
}

.post-button .btn:hover {
  background: linear-gradient(135deg, #0d5569, #2bb5b0);
  color: #fff;
}

figure.highlight,
pre,
.highlight {
  border-radius: 14px;
}

figure.highlight {
  box-shadow: 0 14px 42px rgba(4, 18, 31, 0.22);
  overflow: hidden;
}

.highlight figcaption {
  background: rgba(9, 20, 34, 0.92);
  color: #b7f7f3;
}

.copy-btn {
  border-radius: 999px;
}

.post-eof {
  display: none;
}

.popup {
  opacity: 1;
}

.search-popup {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 18px;
  box-shadow: 0 24px 70px rgba(4, 18, 31, 0.25);
}

#snowfall {
  opacity: 0.72;
}

#live2dcanvas {
  filter: drop-shadow(0 16px 24px rgba(4, 18, 31, 0.2));
}

@media (max-width: 767px) {
  body {
    background-attachment: scroll;
  }

  .home-hero {
    border-radius: 18px;
    margin: 0 0 18px;
    padding: 30px 24px;
  }

  .home-hero__title {
    letter-spacing: 0.04em;
  }

  .post-block {
    border-radius: 16px;
    padding: 24px 20px;
  }

  .sidebar-inner,
  .header-inner {
    background: rgba(255, 255, 255, 0.9);
  }

  .content-wrap {
    background: transparent;
  }

  #snowfall {
    opacity: 0.48;
  }
}
